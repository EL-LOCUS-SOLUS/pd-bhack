#N canvas 0 0 760 520 10;
#X declare -lib xlab;
#X text 24 20 Plot a break-point function from separate X and Y dddd lists.;
#X text 24 47 Inlet 1: X points. Inlet 2: Y points.;
#X text 24 70 Missing X values are generated from 0 to 2000. Missing Y values are generated from 0 to 100.;
#X msg 24 128 0 250 750 1300 2000;
#X obj 24 157 bhack.define;
#X msg 250 128 0 80 25 100 10;
#X obj 250 157 bhack.define;
#X obj 24 220 bhack.bpf -size 300 180;
#X text 24 104 X points;
#X text 250 104 Y points;
#X text 24 438 Send only one list to see the other axis generated automatically.;
#X msg 480 128 size 400 220;
#X text 480 104 Resize the display;
#X connect 4 0 5 0;
#X connect 5 0 8 0;
#X connect 6 0 7 0;
#X connect 7 0 8 1;
#X connect 12 0 8 0;
